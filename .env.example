PGHOST= hostname
PGPORT=port number
PGDATABASE=eegai
PGUSER=postgres
PGPASSWORD=database_user_password

JWT_SECRET=<32charactersecret> 
CORS_ORIGIN= frontend url
PORT=8787

# PGUSER above is who the *app* connects as. It must be a low-privilege role —
# a superuser ignores every row-level security policy, which is this product's
# whole access model.
#
# The schema scripts (db:setup, db:migrate, db:reset) need a superuser to create
# databases, so run those with PGUSER overridden rather than changing it here:
#
#   PGUSER=$(whoami) npm run db:reset
#
# APP_ROLE is the role migrations grant to. It defaults to eegai_app and only
# needs setting if a deployment uses a different name.
# APP_ROLE=eegai_app
