# Copy to .env.local. Never commit .env.local.
#
# These two are the only environment variables the client is allowed to read.
# The anon key is public by design — every table is RLS-gated (PLAN.md §3).
# A service-role key must never appear in this file or any VITE_-prefixed
# variable; privileged work belongs in an Edge Function.

# Local stack: run `npx supabase start` and copy the values it prints.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=
